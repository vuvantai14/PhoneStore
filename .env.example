# ==============================================================
# PhoneStore - Cấu hình biến môi trường cho Docker Compose
# ==============================================================
# Hướng dẫn:
# 1. Sao chép file này thành .env trên máy của bạn:
#    - Windows PowerShell: Copy-Item .env.example .env
#    - Windows CMD:        copy .env.example .env
# 2. Điều chỉnh các tham số nếu cần thiết trước khi khởi chạy.
# ==============================================================

# Cổng truy cập Web từ máy host (mặc định 8080 để tránh xung đột cổng 5015 khi chạy cục bộ trên Windows)
WEB_PORT=8080

# Cổng kết nối SQL Server từ máy host (mặc định 14333 để tránh xung đột cổng 1433 của SQL Server trên Windows)
SQL_PORT=14333

# Mật khẩu tài khoản 'sa' của SQL Server trong Docker container
# Yêu cầu SQL Server: Tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt
MSSQL_SA_PASSWORD=PhoneStore@2026!

# Tên cơ sở dữ liệu dùng trong container Docker (tách biệt hoàn toàn với PhoneStoreDB trên Windows)
DB_NAME=PhoneStoreDockerDB

# Môi trường chạy ASP.NET Core: Development hoặc Production
ASPNETCORE_ENVIRONMENT=Development
