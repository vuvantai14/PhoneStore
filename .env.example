# ==============================================================
# PhoneStore - Cấu hình biến môi trường cho Docker Compose
# ==============================================================
# Hướng dẫn:
# 1. Sao chép file này thành .env trên máy của bạn:
#    - Windows PowerShell: Copy-Item .env.example .env
#    - Windows CMD:        copy .env.example .env
# 2. Bắt buộc đặt mật khẩu mạnh và đường dẫn uploads trước khi validate/chạy.
# ==============================================================

# Tên project cách ly để không tác động stack PhoneStore cũ.
COMPOSE_PROJECT_NAME=phonestore-acceptance

# Các cổng loopback trên máy host.
WEB_PORT=5015
API_PORT=5025

# Cổng kết nối SQL Server từ máy host (14334 để cách ly stack cũ ở 14333 và SQL Server Windows)
SQL_PORT=14334

# Mật khẩu tài khoản 'sa' của SQL Server trong Docker container
# Yêu cầu SQL Server: Tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt
MSSQL_SA_PASSWORD=

# Tên cơ sở dữ liệu dùng trong container Docker (tách biệt hoàn toàn với PhoneStoreDB trên Windows)
DB_NAME=PhoneStoreDockerDB

# Môi trường chạy ASP.NET Core: Development hoặc Production
ASPNETCORE_ENVIRONMENT=Development

# Customer Web gọi API bằng service DNS nội bộ; chỉ bật/tắt qua flag này.
CATALOG_API_ENABLED=true
CATALOG_API_TIMEOUT_SECONDS=3

# Đường dẫn tuyệt đối trên host tới ảnh runtime dùng chung với Admin WinForms.
# Ví dụ Windows (Docker Desktop): C:/PhoneStore/runtime/product-images
PRODUCT_UPLOADS_PATH=
