{
  "ConnectionStrings": {
    "PhoneStoreConnection": "Server=localhost;Database=PhoneStoreDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApiOperational": {
    "MaxQueryStringLength": 2048,
    "MaxRequestLineSize": 4096,
    "CatalogTimeoutSeconds": 10,
    "HealthTimeoutSeconds": 3,
    "CatalogRequestsPerMinute": 60,
    "HealthRequestsPerMinute": 120
  },
  "AllowedHosts": "*"
}
