@model HomeViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebEnvironment
@{
    ViewData["Title"] = "Trang chủ";
    var heroBanner = WebEnvironment.WebRootFileProvider.GetFileInfo("images/banner/bannerhome.jpg").Exists
        ? "/images/banner/bannerhome.jpg"
        : null;
    var brandIcons = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Apple"] = "apple.svg",
        ["Google"] = "google.svg",
        ["OnePlus"] = "oneplus.svg",
        ["OPPO"] = "oppo.svg",
        ["realme"] = "realme.svg",
        ["Samsung"] = "samsung.svg",
        ["vivo"] = "vivo.svg",
        ["Xiaomi"] = "xiaomi.svg"
    };
}

<section class="home-hero">
    <div class="container home-hero-inner">
        <div class="home-hero-copy">
            <span class="home-kicker">PhoneStore</span>
            <h1>Điện thoại chính hãng<br /><span>Công nghệ trong tầm tay</span></h1>
            <p>Khám phá những mẫu điện thoại phù hợp với nhu cầu của bạn.</p>
            <a class="button home-hero-button" href="/products">Khám phá ngay <span aria-hidden="true">→</span></a>
        </div>
        <div class="home-hero-visual" aria-hidden="true">
            @if (heroBanner is not null)
            {
                <img class="hero-banner-image"
                     src="@heroBanner"
                     alt=""
                     width="2172"
                     height="724"
                     loading="eager" />
            }
            else
            {
                <div class="hero-phone-placeholder"><span></span></div>
            }
        </div>
    </div>
</section>

<div class="container home-content">
    @if (Model.Brands.Count > 0)
    {
        <section class="home-section" id="brands" aria-labelledby="brands-title">
            <div class="home-section-heading home-section-heading-centered"><div><h2 id="brands-title">Thương hiệu bạn yêu thích</h2></div><a class="home-section-link" href="/products">Xem tất cả <span aria-hidden="true">→</span></a></div>
            <div class="home-brand-grid">
                @foreach (var brand in Model.Brands)
                {
                    var logoPath = brandIcons.TryGetValue(brand.Name, out var iconFile)
                        && WebEnvironment.WebRootFileProvider.GetFileInfo($"images/brands/{iconFile}").Exists
                        ? $"/images/brands/{iconFile}" : null;
                    <a class="@(logoPath is null ? "brand-card-without-logo" : "brand-card-with-logo")" href="/products?brandId=@brand.Id" aria-label="Xem sản phẩm @brand.Name" title="@brand.Name">
                        <span class="brand-logo-wrap">
                            @if (logoPath is not null)
                            {
                                <span class="brand-logo-box"><img class="brand-logo brand-logo--@(System.IO.Path.GetFileNameWithoutExtension(logoPath))" src="@logoPath" alt="" loading="lazy" width="104" height="40" onerror="this.hidden=true;this.closest('a').classList.add('brand-card-without-logo')" /></span>
                            }
                            <span class="brand-name">@brand.Name</span>
                        </span>
                    </a>
                }
            </div>
        </section>
    }

    <section class="home-section" aria-labelledby="newest-title">
        <div class="home-section-heading home-section-heading-centered"><div><h2 id="newest-title">Điện thoại mới nhất</h2></div><a class="home-section-link" href="/products">Xem tất cả <span aria-hidden="true">→</span></a></div>
        @if (Model.Products.Count == 0) { <partial name="_EmptyCatalog" model='@("Chưa có sản phẩm.")' /> }
        else { <div class="home-product-grid">@foreach (var product in Model.Products) { <partial name="_HomeProductCard" model="product" /> }</div> }
    </section>

    @if (Model.BestSellers.Count > 0)
    {
      <section class="home-section" aria-labelledby="best-sellers-title">
        <div class="home-section-heading home-section-heading-centered">
            <div><span class="home-kicker">Sản phẩm nổi bật</span><h2 id="best-sellers-title">Sản phẩm bán chạy</h2></div>
        </div>
        <div class="home-product-grid">@foreach (var product in Model.BestSellers) { <partial name="_HomeProductCard" model="product" /> }</div>
      </section>
    }

    <section class="home-services" aria-label="Dịch vụ PhoneStore">
        <article><span class="service-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 6h11v11H3zM14 10h4l3 3v4h-7z"/><circle cx="7" cy="19" r="2"/><circle cx="18" cy="19" r="2"/></svg></span><div><h2>Giao hàng toàn quốc</h2><p>Nhận hàng thuận tiện tại địa chỉ của bạn.</p></div></article>
        <article><span class="service-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="m9 12 2 2 4-4"/></svg></span><div><h2>Sản phẩm chính hãng</h2><p>Thông tin sản phẩm rõ ràng, dễ lựa chọn.</p></div></article>
        <article><span class="service-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h12a5 5 0 0 1 0 10H8"/><path d="m8 3-4 4 4 4"/></svg></span><div><h2>Đổi trả dễ dàng</h2><p>Quy trình hỗ trợ rõ ràng và thuận tiện.</p></div></article>
        <article><span class="service-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 13v-2a8 8 0 0 1 16 0v2"/><path d="M4 13h3v6H5a1 1 0 0 1-1-1zM20 13h-3v6h2a1 1 0 0 0 1-1z"/><path d="M17 19c0 1-1 2-3 2"/></svg></span><div><h2>Hỗ trợ khách hàng</h2><p>Đồng hành khi bạn cần tìm hiểu sản phẩm.</p></div></article>
    </section>
</div>
