@model CartViewModel
@using System.Globalization
@{ ViewData["Title"] = "Giỏ hàng"; }
<div class="container purchasing-page cart-page">
    <nav class="breadcrumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span aria-hidden="true">/</span><span aria-current="page">Giỏ hàng</span></nav>
    <div class="catalog-heading"><span class="eyebrow">LỰA CHỌN CỦA BẠN</span><h1>Giỏ hàng</h1><p>Kiểm tra sản phẩm và số lượng trước khi đặt hàng.</p></div>
    @if (TempData["CartMessage"] is string message) { <div class="purchase-message" role="status">@message</div> }
    @if (Model.Items.Count == 0)
    {
        <section class="empty-state"><div class="empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 3h2l3 12h11l2-8H6"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg></div><h2>Giỏ hàng của bạn đang trống.</h2><p>Khám phá điện thoại và thêm lựa chọn phù hợp vào giỏ hàng.</p><a class="button button-primary" href="/products">Tiếp tục mua sắm <span aria-hidden="true">→</span></a></section>
    }
    else
    {
        <div class="purchase-layout"><section class="cart-lines" aria-label="Sản phẩm trong giỏ hàng">
            @foreach (var line in Model.Items)
            {
                <article class="cart-line">
                    <a href="/products/@line.Item.ProductId" class="cart-image"><img src="@ProductImageUrl.LocalOrPlaceholder(line.Product?.ImageUrl)" alt="@(line.Product?.ProductName ?? "Sản phẩm không khả dụng")" width="100" height="100" data-product-image /></a>
                    <div class="cart-line-info"><h2><a href="/products/@line.Item.ProductId">@(line.Product?.ProductName ?? "Sản phẩm không còn khả dụng")</a></h2>
                        @if (line.Product is not null) { <p>@line.Product.Price.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) ₫</p> }
                        @if (!line.Available) { <p class="field-error">Sản phẩm không khả dụng hoặc số lượng vượt tồn kho. Vui lòng cập nhật hoặc xóa.</p> }
                        <form asp-controller="Cart" asp-action="Update" method="post" class="quantity-form" data-ui-submit data-pending-label="Đang cập nhật…">
                            <input type="hidden" name="productId" value="@line.Item.ProductId" /><label for="quantity-@line.Item.ProductId">Số lượng<span class="sr-only"> @(line.Product?.ProductName)</span></label>
                            <input id="quantity-@line.Item.ProductId" type="number" name="quantity" value="@line.Item.Quantity" min="1" step="1" required /><button class="sort-submit" type="submit">Cập nhật</button>
                        </form>
                    </div>
                    <div class="cart-line-total"><strong>@line.LineTotal.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) ₫</strong>
                        <form asp-controller="Cart" asp-action="Remove" method="post" data-ui-submit data-pending-label="Đang xóa…"><input type="hidden" name="productId" value="@line.Item.ProductId" /><button class="remove-item" type="submit" aria-label="Xóa @(line.Product?.ProductName) khỏi giỏ hàng">Xóa sản phẩm</button></form>
                    </div>
                </article>
            }
            <a class="text-link" href="/products">← Tiếp tục mua sắm</a>
        </section><div class="purchase-sidebar"><partial name="_OrderSummary" model="Model" />
            @if (Model.CanCheckout) { <a class="button button-primary purchase-submit" href="/checkout">Tiến hành đặt hàng <span aria-hidden="true">→</span></a> }
            else { <p class="field-error">Vui lòng điều chỉnh giỏ hàng trước khi đặt hàng.</p> }
        </div></div>
    }
</div>
