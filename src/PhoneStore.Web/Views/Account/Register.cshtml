@model PhoneStore.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="auth-compact auth-compact-register">
    <section class="auth-compact-card" aria-labelledby="auth-title">
        <!-- Đầu trang gọn gàng -->
        <div class="auth-compact-header">
            <h1 id="auth-title" class="auth-compact-title">Tạo tài khoản</h1>
            <p class="auth-compact-subtitle">Đăng ký thành viên để mua sắm và theo dõi đơn hàng tiện lợi.</p>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post" class="auth-compact-form" data-ui-submit data-pending-label="Đang tạo tài khoản…">
            <div asp-validation-summary="All" class="auth-compact-errors auth-errors" role="alert" tabindex="-1" data-error-summary aria-label="Thông tin cần kiểm tra"></div>

            <!-- Hàng 1: Họ và tên (50%) & Số điện thoại (50%) -->
            <div class="auth-compact-row-two-col">
                <div class="auth-compact-field">
                    <label asp-for="FullName" class="auth-compact-label">
                        Họ và tên <span class="required-star" aria-hidden="true">*</span>
                    </label>
                    <input asp-for="FullName" class="auth-compact-input" autocomplete="name" placeholder="Nguyễn Văn A" required minlength="2" aria-describedby="name-error" />
                    <span asp-validation-for="FullName" id="name-error" class="field-error"></span>
                </div>

                <div class="auth-compact-field">
                    <div class="auth-compact-label-wrap">
                        <label asp-for="Phone" class="auth-compact-label">Số điện thoại</label>
                        <span class="optional-label">Không bắt buộc</span>
                    </div>
                    <input asp-for="Phone" class="auth-compact-input" type="tel" autocomplete="tel" placeholder="Ví dụ: 0901234567" aria-describedby="phone-error" />
                    <span asp-validation-for="Phone" id="phone-error" class="field-error"></span>
                </div>
            </div>

            <!-- Hàng 2: Email (100%) -->
            <div class="auth-compact-field">
                <label asp-for="Email" class="auth-compact-label">
                    Email <span class="required-star" aria-hidden="true">*</span>
                </label>
                <input asp-for="Email" type="email" class="auth-compact-input" autocomplete="email" inputmode="email" placeholder="email@domain.com" required aria-describedby="email-error" />
                <span asp-validation-for="Email" id="email-error" class="field-error"></span>
            </div>

            <!-- Hàng 3: Mật khẩu (50%) & Xác nhận mật khẩu (50%) -->
            <div class="auth-compact-row-two-col">
                <div class="auth-compact-field">
                    <label asp-for="Password" class="auth-compact-label">
                        Mật khẩu <span class="required-star" aria-hidden="true">*</span>
                    </label>
                    <input asp-for="Password" type="password" value="" class="auth-compact-input" autocomplete="new-password" placeholder="Tối thiểu 8 ký tự" required minlength="8" aria-describedby="password-hint password-error" />
                    <span asp-validation-for="Password" id="password-error" class="field-error"></span>
                </div>

                <div class="auth-compact-field">
                    <label asp-for="ConfirmPassword" class="auth-compact-label">
                        Xác nhận mật khẩu <span class="required-star" aria-hidden="true">*</span>
                    </label>
                    <input asp-for="ConfirmPassword" type="password" value="" class="auth-compact-input" autocomplete="new-password" placeholder="Nhập lại mật khẩu" required aria-describedby="confirm-error" />
                    <span asp-validation-for="ConfirmPassword" id="confirm-error" class="field-error"></span>
                </div>
            </div>

            <p id="password-hint" class="auth-compact-hint">Mật khẩu cần có độ dài từ 8 đến 128 ký tự.</p>

            <button class="button button-primary auth-compact-submit" type="submit">
                <span>Tạo tài khoản</span>
                <span aria-hidden="true">→</span>
            </button>
        </form>

        <div class="auth-compact-footer">
            <p class="auth-compact-switch">
                Đã có tài khoản? <a href="/account/login">Đăng nhập ngay</a>
            </p>
            <a href="/products" class="auth-compact-back">← Tiếp tục khám phá sản phẩm</a>
        </div>
    </section>
</div>
