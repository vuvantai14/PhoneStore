@model ProductDetailViewModel
@using System.Globalization
@{
    var product = Model.Product;
    ViewData["Title"] = product.ProductName;
    var specifications = Model.Specifications;
    var images = product.Images.Count > 0
        ? product.Images.Select(ProductImageUrl.LocalOrPlaceholder).ToList()
        : new List<string> { "/images/product-placeholder.svg" };
}
<div class="container product-detail-page">
    <nav class="breadcrumbs" aria-label="Đường dẫn">
        <a href="/">Trang chủ</a><span aria-hidden="true">/</span>
        <a href="/products">Sản phẩm</a><span aria-hidden="true">/</span>
        <span aria-current="page">@product.ProductName</span>
    </nav>
    <section class="product-overview" aria-labelledby="product-title">
        <div class="product-gallery" data-gallery>
            <div class="gallery-stage">
                <img id="gallery-image" src="@images[0]" alt="@product.ProductName — ảnh 1"
                     width="600" height="560" data-product-image />
            </div>
            @if (images.Count > 1)
            {
                <div class="gallery-thumbnails" aria-label="Ảnh sản phẩm">
                    @for (var index = 0; index < images.Count; index++)
                    {
                        <button type="button" class="gallery-thumbnail" data-gallery-thumbnail
                                data-image="@images[index]" data-alt="@product.ProductName — ảnh @(index + 1)"
                                aria-label="Xem ảnh @(index + 1) của @product.ProductName"
                                aria-pressed="@(index == 0 ? "true" : "false")" aria-controls="gallery-image">
                            <img src="@images[index]" alt="" loading="lazy" width="76" height="76" data-product-image />
                        </button>
                    }
                </div>
            }
        </div>
        <div class="detail-info">
            <a class="eyebrow" href="/products?brandId=@product.BrandId">@product.BrandName</a>
            <h1 id="product-title">@product.ProductName</h1>
            <a class="detail-category" href="/products?categoryId=@product.CategoryId">@product.CategoryName <span aria-hidden="true">↗</span></a>
            <div class="detail-price-area">
                <p class="detail-price">@product.Price.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) <span>₫</span></p>
                <span class="stock-state @(product.StockQuantity > 0 ? "" : "out-of-stock")">
                    <i></i>@(product.StockQuantity > 0 ? "Còn hàng" : "Hết hàng")
                </span>
            </div>
            @if (specifications.Count > 0)
            {
                <div class="key-specifications">
                    @foreach (var specification in specifications.Take(4))
                    {
                        <div><span>@specification.Key</span><strong>@specification.Value</strong></div>
                    }
                </div>
                <a class="text-link" href="#specifications">Xem thông số kỹ thuật <span aria-hidden="true">↓</span></a>
            }
            <div class="detail-browse-note">
                <a href="/products">Tiếp tục khám phá sản phẩm <span aria-hidden="true">→</span></a>
            </div>
        </div>
    </section>
    @if (specifications.Count > 0)
    {
        <section class="detail-section" id="specifications" aria-labelledby="specifications-title">
            <div><span class="eyebrow">HIỂU RÕ LỰA CHỌN</span><h2 id="specifications-title">Thông số kỹ thuật</h2></div>
            <dl class="specification-list">
                @foreach (var specification in specifications)
                {
                    <div><dt>@specification.Key</dt><dd>@specification.Value</dd></div>
                }
            </dl>
        </section>
    }
    @if (!string.IsNullOrWhiteSpace(product.Description))
    {
        <section class="detail-section" aria-labelledby="description-title">
            <div><span class="eyebrow">THÔNG TIN SẢN PHẨM</span><h2 id="description-title">Mô tả sản phẩm</h2></div>
            <p class="product-description">@product.Description</p>
        </section>
    }
    @if (Model.RelatedProducts.Count > 0)
    {
        <section class="section" aria-labelledby="related-title">
            <div class="section-heading"><div><span class="eyebrow">TIẾP TỤC KHÁM PHÁ</span><h2 id="related-title">Sản phẩm liên quan</h2></div><a class="text-link" href="/products">Xem tất cả <span aria-hidden="true">→</span></a></div>
            <div class="product-grid">
                @foreach (var related in Model.RelatedProducts)
                {
                    <partial name="_ProductCard" model="related" />
                }
            </div>
        </section>
    }
</div>
