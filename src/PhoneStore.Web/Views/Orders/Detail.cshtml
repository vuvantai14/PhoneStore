@model PhoneStore.Models.Purchasing.OrderReceipt
@using PhoneStore.Models.Management
@using System.Globalization
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var orderDate = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(Model.OrderDate, DateTimeKind.Utc), TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time"));
}
<div class="container purchasing-page order-detail-page">
    <nav class="breadcrumbs" aria-label="Đường dẫn"><a href="/orders">Đơn hàng của tôi</a><span aria-hidden="true">/</span><span aria-current="page">Chi tiết đơn hàng</span></nav>
    @if (TempData["OrderMessage"] is string message) { <p class="purchase-message" role="status">@message</p> }
    <section class="catalog-heading"><span class="order-status status-@Model.Status.ToString().ToLowerInvariant()">@OrderStatusLabels.Display(Model.Status)</span><h1>Chi tiết đơn hàng</h1><p class="order-code">@Model.OrderCode</p><p>Ngày đặt @orderDate.ToString("dd/MM/yyyy HH:mm")</p></section>
    <div class="purchase-layout"><section class="shipping-panel"><h2>Thông tin giao hàng</h2>
        <dl class="receipt-info"><div><dt>Người nhận</dt><dd>@Model.ReceiverName</dd></div><div><dt>Số điện thoại</dt><dd>@Model.ReceiverPhone</dd></div><div><dt>Địa chỉ</dt><dd>@Model.ShippingAddress</dd></div>@if (!string.IsNullOrWhiteSpace(Model.Note)) { <div><dt>Ghi chú</dt><dd>@Model.Note</dd></div> }</dl>
        @if (Model.Status is PhoneStore.Models.Enums.OrderStatus.Pending or PhoneStore.Models.Enums.OrderStatus.Confirmed)
        {
            <div class="cancel-order-notice"><h3>Bạn muốn hủy đơn hàng?</h3><p>Kiểm tra lại đơn hàng trước khi xác nhận hủy. Thao tác này sẽ kết thúc đơn hàng hiện tại.</p></div>
            <form asp-controller="Orders" asp-action="Cancel" asp-route-id="@Model.OrderId" method="post" class="cancel-order-form" data-ui-submit data-pending-label="Đang gửi yêu cầu…" data-confirm-cancel="Bạn có chắc muốn hủy đơn @Model.OrderCode?">
                <button type="submit" class="button button-danger">Hủy đơn hàng</button>
            </form>
        }
        <a class="button" href="/orders">← Tất cả đơn hàng</a>
    </section><aside class="order-summary"><h2>Sản phẩm đã đặt</h2><ul class="summary-items">
        @foreach (var item in Model.Items) { <li><div><strong>@item.ProductName</strong><span>Số lượng: @item.Quantity · Đơn giá: @item.UnitPrice.ToString("N0", culture) ₫</span></div><b>@((item.Quantity * item.UnitPrice).ToString("N0", culture)) ₫</b></li> }
    </ul><div class="summary-total"><span>Tổng cộng</span><strong>@Model.TotalAmount.ToString("N0", culture) ₫</strong></div></aside></div>
</div>
