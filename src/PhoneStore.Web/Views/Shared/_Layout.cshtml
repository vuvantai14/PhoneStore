@inject PhoneStore.Web.Purchasing.SessionCart CartStore
@{ var current = ViewContext.RouteData.Values["controller"]?.ToString(); }
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#1559d6" />
<meta name="description" content="Khám phá và tìm điện thoại phù hợp tại PhoneStore." />
<title>@ViewData["Title"] · PhoneStore</title>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main-content">Đến nội dung chính</a>
<header class="site-header"><div class="container header-inner">
<a class="wordmark" href="/" aria-label="PhoneStore — Trang chủ"><span class="brand-symbol" aria-hidden="true">P</span>Phone<span>Store</span></a>
<nav class="main-nav" aria-label="Điều hướng chính"><a href="/" aria-current="@(current == "Home" ? "page" : null)">Trang chủ</a><a href="/products" aria-current="@(current == "Products" ? "page" : null)">Sản phẩm</a><a href="/#brands">Thương hiệu</a><a href="/#categories">Danh mục</a></nav>
<form class="header-search" action="/products" method="get" role="search">
<label class="sr-only" for="header-search">Tìm điện thoại</label>
<svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
<input id="header-search" name="search" placeholder="Bạn đang tìm điện thoại nào?" value="@Context.Request.Query["search"]" />
@foreach (var key in new[] { "brandId", "categoryId", "minPrice", "maxPrice", "sort" }) {
if (Context.Request.Query.ContainsKey(key)) { <input type="hidden" name="@key" value="@Context.Request.Query[key]" /> }
}
<button type="submit" aria-label="Tìm kiếm">Tìm</button>
</form>
<div class="header-actions">
@if (User.Identity?.IsAuthenticated == true)
{
    <a class="auth-greeting" href="/orders" title="Đơn hàng của tôi">Xin chào, @User.Identity.Name</a>
    <form asp-controller="Account" asp-action="Logout" method="post" class="header-logout">
        <button type="submit" class="logout-button">Đăng xuất</button>
    </form>
}
else
{
    <a class="auth-entry" href="/account/login" aria-label="Đăng nhập"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 21v-2a7.5 7.5 0 0 1 15 0v2"/></svg><span>Đăng nhập</span></a>
}
<a class="cart-entry" href="/cart" aria-label="Giỏ hàng, @CartStore.Count sản phẩm"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 3h2l3 12h11l2-8H6"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg><span>Giỏ hàng <b>@CartStore.Count</b></span></a>
</div>
</div></header>
<main id="main-content" tabindex="-1">@RenderBody()</main>
<footer class="site-footer"><div class="container footer-main">
<div class="footer-about"><a class="wordmark" href="/"><span class="brand-symbol" aria-hidden="true">P</span>Phone<span>Store</span></a><p>Không gian mua sắm điện thoại chính hãng với thông tin sản phẩm rõ ràng và trải nghiệm thuận tiện.</p></div>
<nav aria-label="Liên kết nhanh"><h2>Liên kết nhanh</h2><a href="/">Trang chủ</a><a href="/products">Sản phẩm</a><a href="/#brands">Thương hiệu</a><a href="/#categories">Danh mục</a></nav>
<nav aria-label="Hỗ trợ khách hàng"><h2>Hỗ trợ khách hàng</h2><a href="/cart">Giỏ hàng</a>@if (User.Identity?.IsAuthenticated == true) { <a href="/orders">Đơn hàng của tôi</a> } else { <a href="/account/login">Đăng nhập</a> }<a href="/Home/Privacy">Chính sách bảo mật</a></nav>
</div><div class="container footer-bottom"><span>© @DateTime.Now.Year PhoneStore</span><span>Điện thoại chính hãng · Công nghệ trong tầm tay</span></div></footer>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
