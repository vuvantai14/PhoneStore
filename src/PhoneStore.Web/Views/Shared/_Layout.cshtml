@inject PhoneStore.Web.Purchasing.SessionCart CartStore
@{ var current = ViewContext.RouteData.Values["controller"]?.ToString(); }
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#1559d6" />
<meta name="description" content="Khám phá và tìm điện thoại phù hợp tại PhoneStore." />
<title>@ViewData["Title"] · PhoneStore</title>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main-content">Đến nội dung chính</a>
<header class="site-header"><div class="container header-inner">
<a class="wordmark" href="/" aria-label="PhoneStore — Trang chủ"><span class="brand-symbol" aria-hidden="true">P</span>Phone<span>Store</span></a>
<nav class="main-nav" aria-label="Điều hướng chính"><a href="/" aria-current="@(current == "Home" ? "page" : null)">Trang chủ</a><a href="/products" aria-current="@(current == "Products" ? "page" : null)">Sản phẩm</a><a href="/brands" aria-current="@(current == "Brands" ? "page" : null)">Thương hiệu</a><a href="/categories" aria-current="@(current == "Categories" ? "page" : null)">Danh mục</a></nav>
<form class="header-search" action="/products" method="get" role="search">
<label class="sr-only" for="header-search">Tìm điện thoại</label>
<svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
<input id="header-search" name="search" placeholder="Bạn đang tìm điện thoại nào?" value="@Context.Request.Query["search"]" />
@foreach (var key in new[] { "brandId", "categoryId", "minPrice", "maxPrice", "sort" }) {
if (Context.Request.Query.ContainsKey(key)) { <input type="hidden" name="@key" value="@Context.Request.Query[key]" /> }
}
<button type="submit" aria-label="Tìm kiếm">Tìm</button>
</form>
<div class="header-actions">
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="header-dropdown account-dropdown" data-header-dropdown>
        <button type="button" class="header-dropdown-trigger auth-greeting-btn" aria-expanded="false" aria-haspopup="true" aria-controls="account-dropdown-menu" id="account-dropdown-trigger">
            <svg class="dropdown-trigger-icon" aria-hidden="true" viewBox="0 0 24 24">
                <circle cx="12" cy="8" r="3.5" fill="none" stroke="currentColor" stroke-width="2"/>
                <path d="M4.5 21v-2a7.5 7.5 0 0 1 15 0v2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <span class="auth-greeting-name">Xin chào, @User.Identity.Name</span>
            <svg class="dropdown-chevron" aria-hidden="true" viewBox="0 0 24 24">
                <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
        <div id="account-dropdown-menu" class="header-dropdown-menu" role="menu" aria-labelledby="account-dropdown-trigger">
            <a class="dropdown-item" href="/account/profile" role="menuitem">
                <svg class="dropdown-item-icon" aria-hidden="true" viewBox="0 0 24 24">
                    <circle cx="12" cy="8" r="3.5" fill="none" stroke="currentColor" stroke-width="2"/>
                    <path d="M4.5 21v-2a7.5 7.5 0 0 1 15 0v2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <span>Hồ sơ của tôi</span>
            </a>
            <a class="dropdown-item" href="/orders" role="menuitem">
                <svg class="dropdown-item-icon" aria-hidden="true" viewBox="0 0 24 24">
                    <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2M9 5h6M9 12h6M9 16h4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Đơn hàng của tôi</span>
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="dropdown-logout-form">
                <button type="submit" class="dropdown-item dropdown-logout-btn" role="menuitem">
                    <svg class="dropdown-item-icon" aria-hidden="true" viewBox="0 0 24 24">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span>Đăng xuất</span>
                </button>
            </form>
        </div>
    </div>
}
else
{
    <a class="auth-entry" href="/account/login" aria-label="Đăng nhập">
        <svg class="dropdown-trigger-icon" aria-hidden="true" viewBox="0 0 24 24">
            <circle cx="12" cy="8" r="3.5" fill="none" stroke="currentColor" stroke-width="2"/>
            <path d="M4.5 21v-2a7.5 7.5 0 0 1 15 0v2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <span>Đăng nhập</span>
    </a>
}
<a class="header-dropdown-trigger cart-entry" href="/cart" aria-label="Giỏ hàng, @CartStore.Count sản phẩm">
    <svg class="dropdown-trigger-icon" aria-hidden="true" viewBox="0 0 24 24">
        <path d="M3 3h2l3 12h11l2-8H6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="9" cy="20" r="1.5" fill="currentColor"/>
        <circle cx="18" cy="20" r="1.5" fill="currentColor"/>
    </svg>
    <span class="cart-entry-text">Giỏ hàng <b>@CartStore.Count</b></span>
</a>
</div>
</div></header>
<main id="main-content" tabindex="-1">@RenderBody()</main>
<footer class="site-footer"><div class="container footer-main">
<div class="footer-about"><a class="wordmark" href="/"><span class="brand-symbol" aria-hidden="true">P</span>Phone<span>Store</span></a><p>Không gian mua sắm điện thoại chính hãng với thông tin sản phẩm rõ ràng và trải nghiệm thuận tiện.</p></div>
<nav aria-label="Liên kết nhanh"><h2>Liên kết nhanh</h2><a href="/">Trang chủ</a><a href="/products">Sản phẩm</a><a href="/brands">Thương hiệu</a><a href="/categories">Danh mục</a></nav>
<nav aria-label="Hỗ trợ khách hàng"><h2>Hỗ trợ khách hàng</h2><a href="/cart">Giỏ hàng</a>@if (User.Identity?.IsAuthenticated == true) { <a href="/orders">Đơn hàng của tôi</a> <a href="/account/profile">Hồ sơ của tôi</a> } else { <a href="/account/login">Đăng nhập</a> <a href="/account/register">Đăng ký</a> }</nav>
</div><div class="container footer-bottom"><span>© @DateTime.Now.Year PhoneStore</span><span>Điện thoại chính hãng · Công nghệ trong tầm tay</span></div></footer>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
